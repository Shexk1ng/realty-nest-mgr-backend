# Copy to .env and fill in real values (never commit .env)

# MongoDB Atlas / local connection string.
# Database name is the path segment after the host — NOT "test" unless you omit it.
# Wrong (defaults to database "test"):
#   mongodb+srv://USER:PASS@cluster.mongodb.net/
# Right (uses database "realty-nest"):
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/realty-nest?retryWrites=true&w=majority

# Signs access tokens and pending 2FA tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# AES-256-GCM key for encrypting TOTP secrets at rest — exactly 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Set to "production" when deploying: disables GraphQL introspection
# and the development DNS override.
PORT=4000
NODE_ENV=

# Podmiana resolwerow DNS w skryptach seedujacych. Domyslnie (brak zmiennej) uzywane sa
# resolwery systemowe -- dzieki temu seed rusza takze w sieci blokujacej publiczne DNS.
#   1                 -> 8.8.8.8 i 1.1.1.1
#   9.9.9.9,1.0.0.1   -> wlasna lista adresow
SEED_DNS_SERVERS=

# --- Konta zakladane przez skrypty seedujace (opcjonalne) ---
# Konto administratora systemu tworzone przez seed:demo i seed:admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator Systemu
# Uzywane wylacznie przez seed:admin; seed:demo ustawia haslo DemoPass123! dla wszystkich kont.
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Magazyn plikow (opcjonalne, ale zalecane przed oddaniem pracy) ---
# Bez tych zmiennych seed:demo generuje dokumenty PDF i zrzuty kopii zapasowych, ale ich
# nie wysyla: rekordy dostaja publicId = null, a przyciski "Pobierz" zwracaja 404.
# Z kluczami pliki trafiaja do Cloudinary jako zasoby "raw" z dostawa "authenticated".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Katalog nadrzedny w Cloudinary; seed zapisuje w <folder>/dokumenty i <folder>/backups.
CLOUDINARY_UPLOAD_FOLDER=realty-nest

# --- Konfiguracja pakietow testowych (opcjonalne) ---
GRAPHQL_URL=http://localhost:4000/graphql
DEMO_PASSWORD=DemoPass123!
COMPANYADMIN_EMAIL=admin@nestrealty.pl

# Ustaw na "true", zeby logowac tresc zapytan GraphQL w konsoli serwera.
DEBUG_GRAPHQL=false
